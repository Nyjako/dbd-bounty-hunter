---
import { characters } from "../data/characters";
import { CHARACTER_TIERS } from "../data/data_storage";
import redX from "../icons/red_X.png";
import { Image } from "astro:assets";

const MAIN_BOUNTY = CHARACTER_TIERS.MAIN_BOUNTY;
const img = characters[MAIN_BOUNTY.survivor];
---

<section class="wanted-poster main-bounty-section">
    <h2 class="tier-name rye-regular">The Main Bounty</h2>
    <p class="reward">
        Worth a flat {MAIN_BOUNTY.worth} points — claimable once per challenge. Click again to undo a misclick.
    </p>
    <div class="poster-grid main-bounty-grid">
        <main-bounty-card>
            <div class="wanted-card main-bounty-card">
                <Image class="wanted_character" src={img} alt={MAIN_BOUNTY.survivor} loading="lazy" />
                <Image class="main-bounty-x" src={redX} alt="" loading="lazy" />
                <span class="main-bounty-ribbon">Main Bounty +{MAIN_BOUNTY.worth}</span>
                <h2 class="survivor-name">{MAIN_BOUNTY.survivor}</h2>
            </div>
        </main-bounty-card>
    </div>
</section>

<script>
    import { appStorage, toggleMainBounty } from "../stores/points";

    customElements.define("main-bounty-card", class extends HTMLElement {
        unsubscribe?: () => void;

        connectedCallback() {
            const card = this.querySelector<HTMLDivElement>(".main-bounty-card");
            if (!card) return;

            const render = () => {
                card.classList.toggle("is-claimed", appStorage.get().mainBountyClaimed);
            };
            render();

            card.addEventListener("click", () => {
                toggleMainBounty();
                render();
            });

            this.unsubscribe = appStorage.listen(() => render());
        }

        disconnectedCallback() {
            this.unsubscribe?.();
        }
    });
</script>
