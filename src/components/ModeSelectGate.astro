---
import "../styles/points_display.css";
import { KILLER_TIERLIST_KEYS, buildKillerLadder, type KillerTierlistKey } from "../data/data_storage";

const TIERLIST_META: Record<KillerTierlistKey, { title: string; description: string }> = {
    ALEX_TIERLIST: {
        title: "Alex's Tierlist",
        description: "The default ranking this challenge has always used.",
    },
    CASUAL_TIERLIST: {
        title: "Casual Tierlist",
        description: "A community-standardized ranking.",
    },
    RELEASE_ORDER: {
        title: "Release Order",
        description: "Climb killers in the order they were actually released, oldest to newest.",
    },
};

const PREVIEW_TIER_ORDER = ["S", "A", "B", "C", "D", "F"] as const;

function buildPreviewGroups(key: KillerTierlistKey) {
    const ladder = buildKillerLadder(key, true);

    if (ladder.every((k) => k.tier === "")) {
        return [{ label: null as string | null, killers: ladder }];
    }

    return PREVIEW_TIER_ORDER.map((tier) => ({
        label: tier as string | null,
        killers: ladder.filter((k) => k.tier === tier).reverse(),
    })).filter((group) => group.killers.length > 0);
}
---

<mode-select-gate>
    <div class="mode-gate-overlay" hidden>
        <div class="mode-gate-content">
            <div class="mode-gate-progress">
                <span class="mode-gate-dot" data-dot="1"></span>
                <span class="mode-gate-dot" data-dot="2"></span>
                <span class="mode-gate-dot" data-dot="3"></span>
                <span class="mode-gate-dot" data-dot="4"></span>
            </div>

            <div class="mode-gate-step" data-step="1">
                <h2 class="rye-regular">Choose Your Killer</h2>
                <div class="mode-options">
                    <button type="button" class="mode-option" data-single-killer="false">
                        <h3>Free Roam</h3>
                        <p>Climb the killer ladder as usual — win streaks and points buy your way up to a stronger killer.</p>
                    </button>
                    <button type="button" class="mode-option" data-single-killer="true">
                        <h3>Single Killer</h3>
                        <p>No upgrades, no rerolls, no tierlist to pick. Choose one killer and run them from the first hunt to the last.</p>
                    </button>
                </div>

                <div class="killer-picker" hidden>
                    <label for="single-killer-select" class="sheet-label">Pick your killer</label>
                    <select id="single-killer-select" class="killer-select"></select>
                    <button type="button" class="buy-button killer-picker-confirm">Confirm Killer</button>
                </div>

                <label class="ptb-toggle">
                    <input type="checkbox" id="ptb-toggle-checkbox" checked />
                    Include PTB content — killers, perks and survivors staged for the current public test build. You can flip this anytime during the run.
                </label>
            </div>

            <div class="mode-gate-step" data-step="2" hidden>
                <button type="button" class="mode-gate-back" data-back>← Back</button>
                <h2 class="rye-regular">Choose Your Tierlist</h2>
                <p class="mode-gate-subtext">Picks which killer ranking this run climbs — decides upgrade order and rerolls.</p>

                <div class="mode-options tierlist-options">
                    {KILLER_TIERLIST_KEYS.map((key) => (
                        <div class="mode-option tierlist-option" data-tierlist={key}>
                            <h3>{TIERLIST_META[key].title}</h3>
                            <p>{TIERLIST_META[key].description}</p>
                            <button type="button" class="tierlist-preview-toggle" data-preview-toggle={key}>Preview list ▾</button>
                        </div>
                    ))}
                </div>

                <div class="tierlist-previews">
                    {KILLER_TIERLIST_KEYS.map((key) => (
                        <div class="tierlist-preview" data-preview={key} hidden>
                            {buildPreviewGroups(key).map((group) => (
                                <div class="tierlist-preview-group">
                                    {group.label && <span class="tier-chip tierlist-preview-tier">{group.label}-tier</span>}
                                    <div class="tierlist-preview-names">
                                        {group.killers.map((k) => (
                                            <span class="tierlist-preview-pill">{k.display_name}</span>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    ))}
                </div>
            </div>

            <div class="mode-gate-step" data-step="3" hidden>
                <button type="button" class="mode-gate-back" data-back>← Back</button>
                <h2 class="rye-regular">Choose Your Perks</h2>
                <div class="mode-options">
                    <button type="button" class="mode-option" data-perk-mode="normal">
                        <h3>Open Shop</h3>
                        <p>Buy a roll from any tier at any time, as long as you can afford it.</p>
                    </button>
                    <button type="button" class="mode-option" data-perk-mode="progression">
                        <h3>Earned Tiers</h3>
                        <p>Start on F-tier only. Buy 4 perks of a tier to unlock the next, all the way up to S.</p>
                    </button>
                </div>
            </div>

            <div class="mode-gate-step" data-step="4" hidden>
                <button type="button" class="mode-gate-back" data-back>← Back</button>
                <h2 class="rye-regular">Choose Your Hunt</h2>
                <div class="mode-options">
                    <button type="button" class="mode-option" data-game-mode="sheriff">
                        <h3>The Sheriff's List</h3>
                        <p>Hunt every survivor on the bounty board. Legendary skins count as their original character, so claiming the character's bounty clears all of their legendary reskins.</p>
                    </button>
                    <button type="button" class="mode-option" data-game-mode="blacklist">
                        <h3>The Black List</h3>
                        <p>Every name. Every face. Every legendary reskin. Each character and every legendary variant must be hunted before the bounty board can be cleared.</p>
                    </button>
                </div>
            </div>
        </div>
    </div>
</mode-select-gate>

<script>
    import { getGameMode, startRun, type GameMode, type PerkMode } from "../stores/points";
    import { buildKillerLadder, DEFAULT_KILLER_TIERLIST, type KillerTierlistKey } from "../data/data_storage";

    customElements.define("mode-select-gate", class extends HTMLElement {
        step = 1;
        tierlistKey: KillerTierlistKey = DEFAULT_KILLER_TIERLIST;
        ptbActive = true;
        singleKillerMode = false;
        chosenKillerName = "";
        perkMode: PerkMode = "normal";

        connectedCallback() {
            const overlay = this.querySelector<HTMLElement>(".mode-gate-overlay");

            if (getGameMode()) {
                this.remove();
                return;
            }

            overlay?.removeAttribute("hidden");
            this.render();

            this.querySelectorAll<HTMLButtonElement>(".tierlist-preview-toggle").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const key = btn.dataset.previewToggle;
                    const preview = this.querySelector<HTMLElement>(`[data-preview="${key}"]`);
                    if (!preview) return;

                    const willOpen = preview.hidden;

                    // Only one preview open at a time — otherwise picking
                    // through all three stacks them all up below the cards.
                    this.querySelectorAll<HTMLElement>(".tierlist-preview").forEach((p) => {
                        p.hidden = true;
                    });

                    preview.hidden = !willOpen;
                });
            });

            // Tierlist choice only matters for climbing/upgrading/rerolling,
            // so it's skipped entirely for Single Killer — that mode picks
            // one killer directly and never touches the ladder again.
            this.querySelectorAll<HTMLButtonElement>("[data-single-killer]").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const isSingle = btn.dataset.singleKiller === "true";
                    this.singleKillerMode = isSingle;
                    this.ptbActive = this.querySelector<HTMLInputElement>("#ptb-toggle-checkbox")?.checked ?? true;

                    if (isSingle) {
                        this.tierlistKey = DEFAULT_KILLER_TIERLIST;
                        this.populateKillerSelect();
                        this.querySelector(".killer-picker")?.removeAttribute("hidden");
                        return;
                    }

                    this.step = 2;
                    this.render();
                });
            });

            this.querySelectorAll<HTMLElement>(".tierlist-option").forEach((card) => {
                card.addEventListener("click", (e) => {
                    if ((e.target as HTMLElement).closest(".tierlist-preview-toggle")) return;

                    this.tierlistKey = card.dataset.tierlist as KillerTierlistKey;
                    this.step = 3;
                    this.render();
                });
            });

            this.querySelector(".killer-picker-confirm")?.addEventListener("click", () => {
                const select = this.querySelector<HTMLSelectElement>("#single-killer-select");
                this.chosenKillerName = select?.value ?? "";
                this.step = 3;
                this.render();
            });

            this.querySelectorAll<HTMLButtonElement>("[data-perk-mode]").forEach((btn) => {
                btn.addEventListener("click", () => {
                    this.perkMode = btn.dataset.perkMode === "progression" ? "progression" : "normal";
                    this.step = 4;
                    this.render();
                });
            });

            this.querySelectorAll<HTMLButtonElement>("[data-back]").forEach((btn) => {
                btn.addEventListener("click", () => this.goBack());
            });

            this.querySelectorAll<HTMLButtonElement>("[data-game-mode]").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const mode = btn.dataset.gameMode as GameMode;
                    if (mode !== "sheriff" && mode !== "blacklist") return;

                    startRun({
                        singleKillerMode: this.singleKillerMode,
                        perkMode: this.perkMode,
                        gameMode: mode,
                        killerTierlist: this.tierlistKey,
                        ptbActive: this.ptbActive,
                        killerName: this.singleKillerMode ? this.chosenKillerName : undefined,
                    });
                    window.location.reload();
                });
            });
        }

        goBack() {
            if (this.step === 2) {
                this.step = 1;
            } else if (this.step === 3) {
                // Single Killer skips step 2 entirely, so back from Perks
                // goes straight to step 1 for that path.
                this.step = this.singleKillerMode ? 1 : 2;
            } else if (this.step === 4) {
                this.step = 3;
            }
            this.render();
        }

        populateKillerSelect() {
            const select = this.querySelector<HTMLSelectElement>("#single-killer-select");
            if (!select) return;

            const ladder = buildKillerLadder(this.tierlistKey, this.ptbActive);
            select.innerHTML = ladder
                .map((killer) => {
                    const label = killer.tier ? `${killer.display_name} (${killer.tier}-tier)` : killer.display_name;
                    return `<option value="${killer.img_name}">${label}</option>`;
                })
                .join("");
        }

        render() {
            this.querySelectorAll<HTMLElement>(".mode-gate-step").forEach((el) => {
                el.hidden = Number(el.dataset.step) !== this.step;
            });
            this.querySelectorAll<HTMLElement>(".mode-gate-dot").forEach((el) => {
                el.classList.toggle("is-active", Number(el.dataset.dot) === this.step);
            });
        }
    });
</script>
