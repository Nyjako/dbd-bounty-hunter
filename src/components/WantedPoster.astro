---
import Portrait from "../components/portrait.astro";
import { characters } from "../data/characters";
import '../styles/character_portrait.css'
import '../styles/fonts.css';
import { CHARACTER_TIERS, getCharacterTierWithPtbFlag, type CharacterTierKey } from "../data/data_storage";
import MainBounty from "../components/MainBounty.astro";

const MAIN_BOUNTY = CHARACTER_TIERS.MAIN_BOUNTY;

// Every tier renders inclusive of PTB_INJECT content up front — each card
// carries its own ptbOnly flag and decides its own visibility client-side,
// since the PTB toggle is a per-player setting, not something known here.
function tierData(tier: CharacterTierKey) {
    return getCharacterTierWithPtbFlag(tier).map(({ name, ptbOnly }) => ({ name, img: characters[name], ptbOnly }));
}

const s_tier_characters_data = tierData("S");
const a_tier_characters_data = tierData("A");
const b_tier_characters_data = tierData("B");
const c_tier_characters_data = tierData("C");
const d_tier_characters_data = tierData("D");
const e_tier_characters_data = tierData("E");

const baseRoster = [
    ...s_tier_characters_data,
    ...a_tier_characters_data,
    ...b_tier_characters_data,
    ...c_tier_characters_data,
    ...d_tier_characters_data,
    ...e_tier_characters_data,
].map(({ name, ptbOnly }) => ({ name, ptbOnly }));
const blacklistRoster = [
    ...CHARACTER_TIERS.LEGENDARY.map((x) => ({ name: x.name, ptbOnly: false })),
    ...baseRoster,
];
---

<header class="hunt-header">
    <div class="fog-layer"></div>
    <div class="wrap">
        <h1 class="sheriff-heading rye-regular">WANTED</h1>
        <p class="bounty-text">
            These survivors have been spotted across the Deadlands
            <br/>
            <b>Hunt your targets and earn your bounty!</b>
        </p>
        <span id="active-mode-badge" class="mode-badge" hidden></span>
    </div>
</header>

<hunt-progress
    data-base-roster={JSON.stringify(baseRoster)}
    data-blacklist-roster={JSON.stringify(blacklistRoster)}
>
    <div class="completion-overlay" hidden>
        <div class="completion-content">
            <h2 class="rye-regular">Every Bounty Collected</h2>
            <p>Every name on the board has been crossed off. The Deadlands remember your work — the hunt is complete.</p>
            <div class="completion-actions">
                <button type="button" class="completion-continue">Continue the Hunt</button>
                <button type="button" class="completion-reset">Clear Progress &amp; Start Over</button>
            </div>
        </div>
    </div>
</hunt-progress>

<MainBounty />

<section class="wanted-poster">
    <h2 class="tier-name rye-regular">The Forgotten Legends</h2>
    <p class="reward">Rare identities from the Deadlands. These legendary survivors carry a different name, a different story, and a higher price on their head.</p>
    <div class="poster-grid"> {CHARACTER_TIERS.LEGENDARY.map( (data) => ( <Portrait points={data.price} img={data.img} name={data.name} correspondingCharacter={data.corresponding_character}/> ) )} </div>
    <h2 class="tier-name rye-regular">The Final Hunt</h2>
    <p class="reward">Reward: 10 points</p>
    <div class="poster-grid"> {s_tier_characters_data.map( (data) => ( <Portrait points=10 img={data.img} name={data.name} ptbOnly={data.ptbOnly} hideUntilMainBountyClaimed={data.name === MAIN_BOUNTY.survivor}/> ) )} </div>
    <h2 class="tier-name rye-regular">Worth the Chase</h2>
    <p class="reward">Reward: 6 points</p>
    <div class="poster-grid"> {a_tier_characters_data.map( (data) => ( <Portrait points=6 img={data.img} name={data.name} ptbOnly={data.ptbOnly} hideUntilMainBountyClaimed={data.name === MAIN_BOUNTY.survivor}/> ) )} </div>
    <h2 class="tier-name rye-regular">Blood Worth Taking</h2>
    <p class="reward">Reward: 5 points</p>
    <div class="poster-grid"> {b_tier_characters_data.map( (data) => ( <Portrait points=5 img={data.img} name={data.name} ptbOnly={data.ptbOnly} hideUntilMainBountyClaimed={data.name === MAIN_BOUNTY.survivor}/> ) )} </div>
    <h2 class="tier-name rye-regular">Routine Hunts</h2>
    <p class="reward">Reward: 3 points</p>
    <div class="poster-grid"> {c_tier_characters_data.map( (data) => ( <Portrait points=3 img={data.img} name={data.name} ptbOnly={data.ptbOnly} hideUntilMainBountyClaimed={data.name === MAIN_BOUNTY.survivor}/> ) )} </div>
    <h2 class="tier-name rye-regular">Easy to Find</h2>
    <p class="reward">Reward: 2 points</p>
    <div class="poster-grid"> {d_tier_characters_data.map( (data) => ( <Portrait points=2 img={data.img} name={data.name} ptbOnly={data.ptbOnly} hideUntilMainBountyClaimed={data.name === MAIN_BOUNTY.survivor}/> ) )} </div>
    <h2 class="tier-name rye-regular">Everyday Prey</h2>
    <p class="reward">Reward: 1 points</p>
    <div class="poster-grid"> {e_tier_characters_data.map( (data) => ( <Portrait points=1 img={data.img} name={data.name} ptbOnly={data.ptbOnly} hideUntilMainBountyClaimed={data.name === MAIN_BOUNTY.survivor}/> ) )} </div>
</section>

<script>
    import { appStorage, getGameMode, isSingleKillerMode, getPerkMode, resetProgress } from "../stores/points";

    customElements.define("hunt-progress", class extends HTMLElement {
        unsubscribe?: () => void;
        dismissed = false;

        connectedCallback() {
            this.renderModeBadge();

            const overlay = this.querySelector<HTMLElement>(".completion-overlay");
            if (!overlay) return;

            type RosterEntry = { name: string; ptbOnly: boolean };
            const baseRoster: RosterEntry[] = JSON.parse(this.dataset.baseRoster || "[]");
            const blacklistRoster: RosterEntry[] = JSON.parse(this.dataset.blacklistRoster || "[]");

            const render = () => {
                const state = appStorage.get();
                const roster = (getGameMode() === "blacklist" ? blacklistRoster : baseRoster).filter(
                    (entry) => !entry.ptbOnly || state.ptbActive,
                );
                const complete =
                    roster.length > 0 &&
                    roster.every((entry) => (state.wantedCards[entry.name] ?? 0) > 0);

                overlay.hidden = !complete || this.dismissed;
            };

            render();

            this.unsubscribe = appStorage.listen(() => render());

            this.querySelector(".completion-continue")?.addEventListener("click", () => {
                this.dismissed = true;
                overlay.hidden = true;
            });

            this.querySelector(".completion-reset")?.addEventListener("click", () => {
                if (!window.confirm("This clears every kill, perk, add-on, and killer rank you've earned. There's no undoing this — clear it all?")) {
                    return;
                }
                resetProgress();
                window.location.reload();
            });
        }

        disconnectedCallback() {
            this.unsubscribe?.();
        }

        renderModeBadge() {
            const badge = document.querySelector<HTMLElement>("#active-mode-badge");
            if (!badge) return;

            const mode = getGameMode();
            if (!mode) return;

            const parts = [mode === "blacklist" ? "The Black List" : "The Sheriff's List"];
            if (isSingleKillerMode()) parts.push("Single Killer");
            if (getPerkMode() === "progression") parts.push("Perk Progression");

            badge.hidden = false;
            badge.textContent = `Mode: ${parts.join(" · ")}`;
        }
    });
</script>
