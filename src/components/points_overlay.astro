---
import "../styles/points_display.css";

import { appStorage } from "../stores/points";

const { points, inventory } = appStorage.get();
const addonItem = inventory.find((item) => item.category === "add-on");
---

<mode-select-gate>
    <div class="mode-gate-overlay" hidden>
        <div class="mode-gate-content">
            <h2 class="rye-regular">Choose Your Hunt</h2>
            <div class="mode-options">
                <button type="button" class="mode-option" data-mode="sheriff">
                    <h3>The Sheriff's List</h3>
                    <p>Hunt every survivor on the bounty board. Legendary skins count as their original character, so claiming the character's bounty clears all of their legendary reskins.</p>
                </button>
                <button type="button" class="mode-option" data-mode="blacklist">
                    <h3>The Black List</h3>
                    <p>Every name. Every face. Every legendary reskin. Each character and every legendary variant must be hunted before the bounty board can be cleared.</p>
                </button>
            </div>
        </div>
    </div>
</mode-select-gate>

<store-modal data-addon-price={addonItem?.price ?? 0}>
    <div class="modal-overlay" aria-hidden="true">
        <div class="modal-content">
            <button class="close-button" aria-label="Close modal">X</button>
            <h2>Outlaw's General Store</h2>

            <!-- Point Balance Display -->
            <div class="point-balance">
                <span class="badge">Your Points: </span>
                <span id="points-display">{points}</span>
            </div>

            <!-- Player / Character Sheet -->
            <section class="player-sheet">
                <h3>Character Sheet</h3>

                <div class="sheet-grid">
                    <div class="sheet-block rank-block">
                        <span class="sheet-label">Killer Rank</span>
                        <div id="rank-display"></div>
                        <div id="killer-actions" class="killer-actions"></div>

                        <div class="sheet-block addons-block">
                            <span class="sheet-label">Add-ons</span>
                            <div id="addon-slots" class="slot-grid addon-slot-grid"></div>
                        </div>
                    </div>

                    <div class="sheet-block perks-block">
                        <span class="sheet-label">Perks</span>
                        <div id="pending-perk-banner" class="pending-perk-banner" hidden></div>
                        <div id="perk-slots" class="slot-grid perk-slot-grid"></div>
                        <div id="perk-shop" class="perk-shop-row"></div>
                    </div>
                </div>
            </section>

            <!-- Danger Zone -->
            <section class="danger-zone">
                <h3>Danger Zone</h3>
                <button type="button" class="reset-button">Delete All Progress</button>
            </section>

            <!-- Confirmation Modal (purchases) -->
            <div class="confirmation-modal hidden">
                <div class="alert-content">
                    <h3>Are ya sure, partner?</h3>
                    <p>You're about to spend <span id="confirm-amount"></span> points. This is a binding agreement between you and the <b>entity</b>.</p>
                    <div class="modal-actions">
                        <button class="confirm-yes">Yeehaw! Take My Points!</button>
                        <button class="confirm-no">Nah, I'm Good</button>
                    </div>
                </div>
            </div>

            <!-- Reset Confirmation Modal -->
            <div class="confirmation-modal reset-confirm hidden">
                <div class="alert-content">
                    <h3>Erase the Legend?</h3>
                    <p>This clears every kill, perk, add-on, and killer rank you've earned. There's <b>no</b> undoing this, partner.</p>
                    <div class="modal-actions">
                        <button class="reset-yes">Yeehaw! Burn It Down</button>
                        <button class="reset-no">Nah, I'm Good</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</store-modal>

<points-display>
    Points: <span class="points-value">0</span>
</points-display>

<script>
    import {
        appStorage,
        purchaseItem,
        purchaseAddonUpgrade,
        equipPendingPerk,
        canAffordItem,
        canAffordAddonUpgrade,
        isMaxKiller,
        resetProgress,
        setGameMode,
        getGameMode,
        ADDON_TIERS,
        ADDON_TIER_COLORS,
        type AppStorage,
    } from "../stores/points.ts";
    import { perks as perkIcons } from "../data/perks.ts";
    import { characters } from "../data/characters.ts";
    import { KILLER_LADDER } from "../data/data_storage.ts";

    type PendingPurchase =
        | { kind: "item"; id: string; cost: number }
        | { kind: "addon"; slot: number; cost: number };

    customElements.define("mode-select-gate", class extends HTMLElement {
        connectedCallback() {
            const overlay = this.querySelector<HTMLElement>(".mode-gate-overlay");

            if (getGameMode()) {
                // Already chosen — stays hidden, nothing to wire up.
                this.remove();
                return;
            }

            overlay?.removeAttribute("hidden");

            this.querySelectorAll<HTMLButtonElement>(".mode-option").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const mode = btn.dataset.mode;
                    if (mode !== "sheriff" && mode !== "blacklist") return;
                    setGameMode(mode);
                    window.location.reload();
                });
            });
        }
    });

    class PointsDisplay extends HTMLElement {
        unsubscribe?: () => void;

        connectedCallback() {
            const value = this.querySelector(".points-value");

            if (!value) return;

            value.textContent = appStorage.get().points.toString();

            this.addEventListener("click", () => {
                const modal = document.querySelector("store-modal");
                (modal as any)?.open?.();
            });

            this.unsubscribe = appStorage.listen((newValue) => {
                value.textContent = newValue.points.toString();
            });
        }

        disconnectedCallback() {
            this.unsubscribe?.();
        }
    }

    customElements.define("points-display", PointsDisplay);

    customElements.define("store-modal", class extends HTMLElement {
        unsubscribe?: () => void;
        confirmationModal: HTMLElement | null = null;
        resetConfirmModal: HTMLElement | null = null;
        pendingPurchase: PendingPurchase | null = null;

        scrollToPerkSelection() {
            const modalContent = this.querySelector<HTMLElement>(".modal-content");
            const banner = this.querySelector<HTMLElement>("#pending-perk-banner");

            if (!modalContent || !banner) return;

            requestAnimationFrame(() => {
                modalContent.scrollTo({
                    top: banner.offsetTop - 20,
                    behavior: "smooth",
                });
            });
        }

        connectedCallback() {
            const modals = this.querySelectorAll<HTMLElement>(".confirmation-modal");
            this.confirmationModal = modals[0] ?? null;
            this.resetConfirmModal = this.querySelector(".reset-confirm");

            this.render(appStorage.get());

            this.setupConfirmationHandlers();
            this.setupResetHandlers();
            this.setupCloseHandlers();

            this.unsubscribe = appStorage.listen((state) => this.render(state));
        }

        disconnectedCallback() {
            this.unsubscribe?.();
            this.hideConfirmationModal();
            this.hideResetModal();
        }

        // ---------- master render ----------
        render(state: AppStorage) {
            this.renderPoints(state);
            this.renderRank(state);
            this.renderKillerActions(state);
            this.renderPerkSlots(state);
            this.renderPerkShop(state);
            this.renderAddonSlots(state);
        }

        renderPoints(state: AppStorage) {
            const display = this.querySelector("#points-display");
            if (display) display.textContent = state.points.toString();
        }

        // ---------- killer rank ----------
        renderRank(state: AppStorage) {
            const el = this.querySelector("#rank-display");
            if (!el) return;

            const killer = KILLER_LADDER[state.killerIndex];
            const iconSrc = (characters as Record<string, any>)[killer.img_name]?.src;

            el.innerHTML = `
                <div class="killer-portrait-wrap">
                    ${iconSrc ? `<img class="killer-portrait" src="${iconSrc}" alt="${killer.display_name}" />` : ""}
                </div>
                <div class="killer-name">${killer.display_name}</div>
                <span class="tier-chip">${killer.tier}-tier</span>
            `;
        }

        renderKillerActions(state: AppStorage) {
            const container = this.querySelector<HTMLElement>("#killer-actions");
            if (!container) return;

            const maxed = isMaxKiller(state.killerIndex);
            const killerItems = state.inventory.filter(
                (i) => i.category === "killer" && (!maxed || i.price === 0),
            );

            container.innerHTML = killerItems
                .map((item) => {
                    const label = maxed
                        ? item.price > 0
                            ? `Reroll Killer — ${item.price} pts`
                            : "Reroll Killer (2 wins in a row)"
                        : item.price > 0
                            ? `Upgrade — ${item.price} pts`
                            : "Free Upgrade (2 wins in a row)";

                    return `<button type="button" class="buy-button killer-action-button" data-id="${item.id}" data-cost="${item.price}">${label}</button>`;
                })
                .join("");

            container.querySelectorAll<HTMLButtonElement>(".killer-action-button").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const id = btn.dataset.id!;
                    const cost = Number(btn.dataset.cost ?? "0");
                    this.pendingPurchase = { kind: "item", id, cost };
                    this.showConfirmationModal(cost);
                });
            });
        }

        // ---------- perk slots ----------
        renderPerkSlots(state: AppStorage) {
            const banner = this.querySelector<HTMLElement>("#pending-perk-banner");
            const grid = this.querySelector<HTMLElement>("#perk-slots");
            if (!grid) return;

            const pending = state.pendingPerk;

            if (banner) {
                if (pending) {
                    banner.hidden = false;
                    banner.innerHTML = `Rolled <strong>${pending.name}</strong> <span class="tier-chip">${pending.tier}-tier</span> — pick a slot below to equip it.`;
                } else {
                    banner.hidden = true;
                    banner.innerHTML = "";
                }
            }

            grid.innerHTML = state.perkSlots
                .map((slot, index) => {
                    const iconSrc = slot ? (perkIcons as Record<string, any>)[slot.name]?.src : null;
                    const content = slot
                        ? `
                            ${iconSrc ? `<img class="perk-icon" src="${iconSrc}" alt="" loading="lazy" />` : ""}
                            <span class="perk-name">${slot.name}</span>
                            <span class="tier-chip">${slot.tier}-tier</span>
                        `
                        : `<span class="perk-name empty">Empty Slot</span>`;

                    const clickable = Boolean(pending);

                    return `
                        <button
                            type="button"
                            class="slot-card perk-slot ${clickable ? "is-clickable" : ""}"
                            data-slot-index="${index}"
                            ${clickable ? "" : "disabled"}
                        >
                            ${content}
                            ${clickable ? `<span class="slot-cta">Place here</span>` : ""}
                        </button>
                    `;
                })
                .join("");

            grid.querySelectorAll<HTMLButtonElement>(".perk-slot").forEach((btn) => {
                btn.addEventListener("click", () => {
                    if (!appStorage.get().pendingPerk) return;
                    const index = Number(btn.dataset.slotIndex);
                    equipPendingPerk(index);
                });
            });
        }

        renderPerkShop(state: AppStorage) {
            const container = this.querySelector<HTMLElement>("#perk-shop");
            if (!container) return;

            const perkItems = state.inventory.filter((i) => i.category === "perk");

            container.innerHTML = perkItems
                .map(
                    (item) => `
                        <button type="button" class="buy-button perk-shop-button" data-id="${item.id}" data-cost="${item.price}">
                            ${item.perkTier}-Tier — ${item.price} pts
                        </button>
                    `,
                )
                .join("");

            container.querySelectorAll<HTMLButtonElement>(".perk-shop-button").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const id = btn.dataset.id!;
                    const cost = Number(btn.dataset.cost ?? "0");
                    this.pendingPurchase = { kind: "item", id, cost };
                    this.showConfirmationModal(cost);
                });
            });
        }

        // ---------- addon slots ----------
        renderAddonSlots(state: AppStorage) {
            const grid = this.querySelector<HTMLElement>("#addon-slots");
            if (!grid) return;

            const addonPriceAttr = this.getAttribute("data-addon-price");
            const addonPrice = Number(addonPriceAttr ?? 0);

            grid.innerHTML = state.addonSlots
                .map((tierIndex, index) => {
                    const tierName = ADDON_TIERS[tierIndex];
                    const tierColor = ADDON_TIER_COLORS[tierName];
                    const maxed = tierIndex >= ADDON_TIERS.length - 1;

                    return `
                        <div class="slot-card addon-slot">
                            <span class="tier-chip addon-tier" style="color:${tierColor};border-color:${tierColor}66;background:${tierColor}1a;">${tierName}</span>
                            <div class="addon-dots">
                                ${ADDON_TIERS.map((t, i) => `<span class="dot ${i <= tierIndex ? "filled" : ""}" style="${i <= tierIndex ? `background:${ADDON_TIER_COLORS[t]};border-color:${ADDON_TIER_COLORS[t]};` : ""}"></span>`).join("")}
                            </div>
                            ${
                                maxed
                                    ? `<span class="slot-cta muted">Maxed out</span>`
                                    : `<button type="button" class="upgrade-addon-button" data-addon-slot="${index}" data-cost="${addonPrice}">Upgrade — ${addonPrice} pts</button>`
                            }
                        </div>
                    `;
                })
                .join("");

            grid.querySelectorAll<HTMLButtonElement>(".upgrade-addon-button").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const slot = Number(btn.dataset.addonSlot);
                    const cost = Number(btn.dataset.cost ?? "0");
                    this.pendingPurchase = { kind: "addon", slot, cost };
                    this.showConfirmationModal(cost);
                });
            });
        }

        // ---------- purchase confirmation modal ----------
        showConfirmationModal(cost: number) {
            const amountDisplay = this.querySelector("#confirm-amount");
            if (amountDisplay) amountDisplay.textContent = cost.toString();
            this.confirmationModal?.classList.remove("hidden");
        }

        hideConfirmationModal() {
            this.confirmationModal?.classList.add("hidden");
        }

        setupConfirmationHandlers() {
            const yesBtn = this.confirmationModal?.querySelector(".confirm-yes");
            const noBtn = this.confirmationModal?.querySelector(".confirm-no");

            yesBtn?.addEventListener("click", () => {
                const purchase = this.pendingPurchase;
                if (!purchase) return;

                let success = false;
                let afford = false;

                if (purchase.kind === "item") {
                    afford = canAffordItem(purchase.id);
                    if (afford) success = purchaseItem(purchase.id);
                } else {
                    afford = canAffordAddonUpgrade();
                    if (afford) success = purchaseAddonUpgrade(purchase.slot);
                }

                this.hideConfirmationModal();

                if (!afford) {
                    this.showLowGoldAlert();
                } else if (!success) {
                    this.showAlert(
                        "No Luck, Partner",
                        "That didn't go through — that tier might be fully claimed already, or the slot's maxed out.",
                    );
                } else if (purchase.kind === "item") {
                    const state = appStorage.get();

                    if (state.pendingPerk) {
                        this.scrollToPerkSelection();
                    }
                }

                this.pendingPurchase = null;
            });

            noBtn?.addEventListener("click", () => {
                this.hideConfirmationModal();
                this.pendingPurchase = null;
            });
        }

        // ---------- reset confirmation modal ----------
        showResetModal() {
            this.resetConfirmModal?.classList.remove("hidden");
        }

        hideResetModal() {
            this.resetConfirmModal?.classList.add("hidden");
        }

        setupResetHandlers() {
            const resetBtn = this.querySelector(".reset-button");
            const yesBtn = this.resetConfirmModal?.querySelector(".reset-yes");
            const noBtn = this.resetConfirmModal?.querySelector(".reset-no");

            resetBtn?.addEventListener("click", () => this.showResetModal());

            yesBtn?.addEventListener("click", () => {
                resetProgress();
                window.location.reload();
            });

            noBtn?.addEventListener("click", () => this.hideResetModal());
        }

        setupCloseHandlers() {
            const closeBtn = this.querySelector(".close-button");
            const overlay = this.querySelector(".modal-overlay");

            closeBtn?.addEventListener("click", () => this.close());

            overlay?.addEventListener("click", (e) => {
                if (e.target === overlay) this.close();
            });
        }

        open() {
            this.classList.add("is-open");
            this.querySelector(".modal-overlay")?.setAttribute("aria-hidden", "false");
        }

        close() {
            this.classList.remove("is-open");
            this.querySelector(".modal-overlay")?.setAttribute("aria-hidden", "true");
            this.hideConfirmationModal();
            this.hideResetModal();
            this.pendingPurchase = null;
        }

        showLowGoldAlert() {
            this.showAlert(
                "Out of Points, Partner!",
                "You don't have enough points to make this purchase. Go rob a bank or sell your soul for more.",
            );
        }

        showAlert(title: string, body: string) {
            const modal = document.createElement("div");
            modal.className = "low-gold-alert";
            modal.innerHTML = `
                <div class="alert-content">
                    <h3>${title}</h3>
                    <p>${body}</p>
                    <button class="close-alert">I'll be better... someday</button>
                </div>
            `;

            document.body.appendChild(modal);

            const closeBtn = modal.querySelector(".close-alert");
            closeBtn?.addEventListener("click", () => modal.remove());
        }
    });
</script>
